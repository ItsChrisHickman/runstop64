{
  "name": "runstop64",
  "private": true,
  "type": "module",
  "description": "RUN/STOP on the C64 classics: browser remakes of Commodore 64 games on a shared kit.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen": "node tools/gen.mjs",
    "predev": "node tools/gen.mjs",
    "dev": "vite",
    "prebuild": "node tools/gen.mjs",
    "build": "npm run typecheck && npm run check:strict && node tools/extract-awm-sid.mjs --ensure && vite build",
    "preview": "vite preview",
    "pretypecheck": "node tools/gen.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "pretest:touch": "node tools/gen.mjs",
    "test:touch": "esbuild games/shared/touch/test/touch.test.ts --bundle --platform=node --format=esm --alias:c64kit=./games/shared/touch/test/kit.ts --log-level=warning | node --input-type=module",
    "test:effects": "node tools/test.mjs packages/c64kit/test/effects.test.ts",
    "extract:motr": "node tools/extract-motr.mjs",
    "predeploy": "node tools/gen.mjs",
    "deploy": "tools/deploy-goshowme.sh",
    "precheck:strict": "node tools/gen.mjs",
    "check:strict": "node tools/strict.mjs",
    "pretest": "node tools/gen.mjs",
    "test": "node tools/test-all.mjs",
    "verify": "npm run typecheck && npm run check:strict && npm test",
    "test:input": "node tools/test.mjs packages/c64kit/test/input.test.ts"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "esbuild": "0.21.5",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}
